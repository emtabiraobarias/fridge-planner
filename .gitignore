node_modules/
dist/
coverage/
.env
*.local
.DS_Store

# Client build/cache dirs (both implementations — Vite SPA and Next.js)
packages/client/node_modules/.vite/
packages/client/.next/

# Playwright transient artifacts (keep e2e/screenshots/ as committed proof)
packages/client/test-results/
packages/client/playwright-report/
packages/client/.playwright/
packages/client/e2e/.auth/

# Local Claude tooling (keep tracked slash-commands only)
.claude/*
!.claude/commands/
!.claude/commands/**
packages/client/.next-e2e/

# Generated by Next at build time, and NOT stable here: this repo builds into two output dirs
# (.next for dev, .next-e2e for the Playwright gate), so Next rewrites the reference path inside
# this file every time you switch between them. Tracked, it produced a permanently-dirty working
# tree that blocked scripts/sync-impls.sh and forced a stash before every e2e run. Next's docs
# say to commit it; that advice assumes a single build dir.
packages/client/next-env.d.ts
